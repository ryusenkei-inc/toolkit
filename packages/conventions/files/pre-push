#!/bin/sh
# push の前の検査（`check` のスクリプトを持つリポのみ。CI の失敗・Actions の消費を手元で防止）
# hostslot があれば資源の空きを待って実行（並行するエージェント・リポの重い検査によるメモリの枯渇を防止）
#   `check` のないリポは枠を待たない
if grep -q '"check":' package.json 2>/dev/null && command -v hostslot >/dev/null 2>&1; then
  exec hostslot run --weight 2 -- pnpm run check
fi
exec pnpm run --if-present check
