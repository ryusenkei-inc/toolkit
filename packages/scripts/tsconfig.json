{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@ryusenkei/core": [
        "../core/src/index.ts"
      ],
      "@ryusenkei/core/*": [
        "../core/src/*/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
