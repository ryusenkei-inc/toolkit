{
  "name": "@ryusenkei/form",
  "version": "0.2.1",
  "description": "フォームの受け取り（項目の宣言・整形・検査、受け取りの処理、届け先、送信の型）",
  "license": "MIT",
  "author": "RYUSENKEI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryusenkei-inc/toolkit.git",
    "directory": "packages/runtime/form"
  },
  "homepage": "https://github.com/ryusenkei-inc/toolkit/tree/main/packages/runtime/form",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ryusenkei/core": "workspace:^0.2.0",
    "@ryusenkei/mail": "workspace:^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
