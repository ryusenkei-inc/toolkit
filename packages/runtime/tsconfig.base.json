{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@ryusenkei/*/testing": [
        "./*/src/testing.ts"
      ],
      "@ryusenkei/*/contract": [
        "./*/src/contract.ts"
      ],
      "@ryusenkei/*": [
        "./*/src/index.ts"
      ]
    }
  }
}
