{
  "name": "@ryusenkei/toolkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r typecheck && node packages/prose-lint/src/cli.ts",
    "lint:prose": "node packages/prose-lint/src/cli.ts",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
